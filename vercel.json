{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "node_modules/{pdfkit,unpdf,pdfjs-dist}/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.(js|css|html|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
